%!PS-Adobe-3.0
%%Pages: 3
%%BoundingBox: 0 0 842 1200
%%EndComments
[/Title (SNACKPDF_METADATA_MARKER_7F3A) /Author (SnackPDF fixture) /DOCINFO pdfmark

<< /PageSize [595 842] >> setpagedevice
/Helvetica findfont 24 scalefont setfont
0 setgray 72 770 moveto (SNACKPDF_TEXT_MARKER_7F3A) show
1 0 0 setrgbcolor 72 650 150 70 rectfill
0 0.55 0 setrgbcolor 235 650 150 70 rectfill
0 0 1 setrgbcolor 398 650 125 70 rectfill
gsave
72 500 translate 120 120 scale
2 2 8 [2 0 0 -2 0 2] {<FF000000FF000000FFFFFFFF>} false 3 colorimage
grestore
gsave
systemdict /.setopacityalpha known { 0.55 .setopacityalpha } if
1 0.4 0 setrgbcolor 170 500 220 120 rectfill
0 0 0 setrgbcolor /Times-Roman findfont 18 scalefont setfont 190 550 moveto (vector and transparency) show
grestore
[/Rect [72 420 300 450] /Border [0 0 1] /Action << /Subtype /URI /URI (https://example.invalid/snackpdf-fixture) >> /Subtype /Link /ANN pdfmark
[/Title (Fixture page one) /Page 1 /OUT pdfmark
showpage

<< /PageSize [842 595] >> setpagedevice
/Courier findfont 20 scalefont setfont
0 setgray 72 520 moveto (Mixed orientation landscape page) show
0 1 20 {
  /stripe exch def
  stripe 20 div 1 exch sub stripe 40 div 0.35 setrgbcolor
  72 stripe 16 mul 120 add 680 12 rectfill
} for
[/Title (Fixture landscape page) /Page 2 /OUT pdfmark
showpage

<< /PageSize [300 1200] >> setpagedevice
/Helvetica findfont 16 scalefont setfont
0 setgray 30 1140 moveto (Unusual tall page) show
0 0 0 setrgbcolor 30 80 240 1000 rectstroke
0 1 12 {
  /item exch def
  item 12 div 0.2 1 item 12 div sub setrgbcolor
  45 item 75 mul 150 add 210 45 rectfill
} for
showpage
%%EOF
